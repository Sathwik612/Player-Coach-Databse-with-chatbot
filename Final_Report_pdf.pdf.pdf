/T (//  API to Update Player Tactics app.post\("/api/update-tactics", async \(req, res\) => {  try {   const { playerId, newTactics } = req.body;   if \(!playerId || !newTactics\) {    return res.status\(400\).json\({ error: "Player ID and new tactics are required" }\);   }   await Player.findByIdAndUpdate\(playerId, { tactics: newTactics }\);   res.json\({ message: "Tactics updated successfully" }\);  } catch \(error\) {   console.error\(" Error updating tactics:", error\);   res.status\(500\).json\({ error: "Failed to update tactics" }\);  } }\);)
/E (//  API to Update Player Tactics app.post\("/api/update-tactics", async \(req, res\) => {  try {   const { playerId, newTactics } = req.body;   if \(!playerId || !newTactics\) {    return res.status\(400\).json\({ error: "Player ID and new tactics are required" }\);   }   await Player.findByIdAndUpdate\(playerId, { tactics: newTactics }\);   res.json\({ message: "Tactics updated successfully" }\);  } catch \(error\) {   console.error\(" Error updating tactics:", error\);   res.status\(500\).json\({ error: "Failed to update tactics" }\);  } }\);)
